# Postgres (used by both docker-compose and the Go server)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chamado-db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Server
JWT_SECRET=change-this-secret
SERVER_PORT=:8083

# Default admin account, seeded automatically by start.sh on first run
# (only if it doesn't already exist). Change these for a real deployment.
ADMIN_NAME=Admin Geral
ADMIN_PASSWORD=senha123
ADMIN_TEAM=TLM
